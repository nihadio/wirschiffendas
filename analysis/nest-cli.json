{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/coordinator/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/coordinator/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": [
            "Dto.ts",
            "Config.ts"
          ],
          "controllerFileNameSuffix": [
            "Controller.ts"
          ]
        }
      }
    ]
  },
  "monorepo": true,
  "root": "apps/coordinator",
  "projects": {
    "config": {
      "type": "application",
      "root": "apps/config",
      "entryFile": "main",
      "sourceRoot": "apps/config/src",
      "compilerOptions": {
        "tsConfigPath": "apps/config/tsconfig.app.json",
        "plugins": [
          {
            "name": "@nestjs/swagger",
            "options": {
              "dtoFileNameSuffix": [
                "Dto.ts",
                "Config.ts"
              ],
              "controllerFileNameSuffix": [
                "Controller.ts"
              ]
            }
          }
        ]
      }
    },
    "coordinator": {
      "type": "application",
      "root": "apps/coordinator",
      "entryFile": "main",
      "sourceRoot": "apps/coordinator/src",
      "compilerOptions": {
